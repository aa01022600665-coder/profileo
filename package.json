{
  "name": "profileo",
  "version": "1.3.7",
  "description": "Browser Profile Manager - Desktop Application",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:android": "set VITE_ENABLE_ANDROID=true&& set PROFILEO_ENABLE_ANDROID=true&& electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "node scripts/ensure-profileo-browser.mjs && electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.profileo.app",
    "productName": "Profileo",
    "artifactName": "Profileo.Setup.${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aa01022600665-coder",
        "repo": "profileo",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": ".profileo-browsers-test/chromium",
        "to": "browsers/chromium",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/extensions/auto-click-recorder",
        "to": "extensions/auto-click-recorder",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/android-apps",
        "to": "android-apps",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nowpaymentsio/nowpayments-api-js": "^1.0.5",
    "@puppeteer/browsers": "^2.13.2",
    "@xyflow/react": "^12.10.1",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "firebase": "^12.10.0",
    "nodemailer": "^8.0.1",
    "puppeteer-core": "^24.37.5",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^40.6.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
